# Copie este archivo a .env.local y complete los valores.
# Local: los valores salen de `npx supabase status` después de `npm run db:start`.

# URL pública del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Llave pública (anon / publishable). Segura para el navegador; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave service_role. SOLO pruebas RLS y scripts. Nunca en código de cliente ni en Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# URL base de la app (enlaces de invitación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
