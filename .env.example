# Copia este archivo a .env.local y completa los valores.
# Local: los valores salen de `npx supabase status` después de `npm run db:start`.

# URL pública del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Llave pública (anon / publishable). Segura para el navegador; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave service_role (salta RLS). Pruebas RLS, scripts y /api/avisos (avisos programados). Nunca en código de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# URL base de la app (enlaces de invitación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Asistente de comprobantes y extractos en PDF (solo servidor; nunca NEXT_PUBLIC_).
# Basta una de las dos llaves. Con las dos, cada hogar elige en Configuración → Hogar → Asistente de IA.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Opcionales: proveedor por defecto (anthropic | openai) y modelo por defecto de cada uno.
# IA_PROVEEDOR=anthropic
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-6.1-sol

# Captcha de Cloudflare Turnstile en ingreso, registro y recuperación (vacío = sin captcha). La llave secreta va en
# Supabase (Authentication → Attack Protection), no aquí. Ver docs/DESPLIEGUE.md §1.2.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 1 cuando el proveedor Google esté activo en Supabase: muestra «Continuar con Google» (§1.3).
NEXT_PUBLIC_GOOGLE_ACTIVO=
# Solo para probar Google en Supabase local (supabase/config.toml lee estas dos).
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Correos propios de la app (bienvenida, invitaciones, avisos). Sin llave, en local van a Mailpit
# (http://127.0.0.1:54324) y en producción no se envían. Ver docs/DESPLIEGUE.md §1.1.
RESEND_API_KEY=
CORREO_REMITENTE=My House <no-responder@tu-dominio.com>
# Avisos programados (/api/avisos y /api/cobros, Vercel Cron): protege las rutas. Usan también SUPABASE_SERVICE_ROLE_KEY.
CRON_SECRET=

# Cobro de los planes con Wompi (docs/DESPLIEGUE.md §2.1). Sin las tres, la app no ofrece pagar.
# Llaves de pruebas (pub_test_…, test_integrity_…, test_events_…) para el sandbox; luego las de producción.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Solo para probar en un build local: ver los correos en /dev/correos y simular la fecha con /api/avisos?hoy=AAAA-MM-DD.
# VISTA_CORREOS=1
# AVISOS_SIMULAR_FECHA=1
# Opcionales de /api/avisos: correos por segundo (límite de Resend, 2 por defecto) y hogares por página
# (100 por defecto; con 1 se prueba en local que las vueltas se encadenan).
# AVISOS_CORREOS_POR_SEGUNDO=2
# AVISOS_HOGARES_POR_PAGINA=100

# Content Security Policy: se publica como Report-Only (solo avisa en la consola). `activa` la vuelve obligatoria.
# CSP_MODO=activa
